# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5010
API_PREFIX=/api/v1
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/acd_cafe
# Used by `npm test` only. The database name MUST end with _test — the suite
# drops it, and the helper refuses to run against any other name.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/acd_cafe_test

# ─── Auth (staff PIN login) ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_NAME=acd_cafe_token
# How the session cookie is scoped: lax | strict | none
#   lax  — correct whenever the browser app and this API share a registrable
#          domain. localhost:3000 -> localhost:5010 counts (SameSite ignores
#          the port), and so does app.cafe.com -> api.cafe.com.
#   none — only for genuinely different domains. Requires HTTPS.
COOKIE_SAMESITE=lax
# Set to share the cookie across subdomains, e.g. .cafe.com
COOKIE_DOMAIN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma separated list of allowed origins for REST + Socket.IO.
#
# These are ORIGINS, not URLs: scheme + host (+ port), never a trailing slash
# and never a path. "https://site.com/" fails to match "https://site.com".
#
# Do NOT list this API's own origin here. A browser sends no Origin header on a
# same-origin request, and server-to-server calls (Next.js SSR fetching this
# API) send none either — both are already allowed.
CORS_ORIGINS=http://localhost:3000

# ─── Customer QR ─────────────────────────────────────────────────────────────
# Base URL printed into the table QR codes: <CUSTOMER_BASE_URL>/order/<tableCode>
#
# Getting this wrong is expensive: it is baked into stickers that get printed
# once. Set it to the public site before generating the QR sheet.
CUSTOMER_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION VALUES (tapriwala.acdwithsameer.com)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this block into the .env on the VPS. Do not commit the filled-in copy.
#
#   NODE_ENV=production
#   PORT=5010
#
#   # Long and random. Generate, never invent:
#   #   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   JWT_SECRET=<paste the generated value>
#
#   # The site and the API share the registrable domain acdwithsameer.com, so
#   # the browser treats them as SAME-SITE and `lax` is enough. `none` would
#   # also work but is strictly more permissive — do not reach for it here.
#   COOKIE_SAMESITE=lax
#
#   # Leave EMPTY. Blank scopes the cookie to this API's own host, which is
#   # what you want: the frontend never reads it, it only needs to travel back
#   # to the API. Setting `.acdwithsameer.com` would hand the staff session to
#   # every other subdomain you ever host on that domain.
#   COOKIE_DOMAIN=
#
#   CORS_ORIGINS=https://tapriwala.acdwithsameer.com
#   CUSTOMER_BASE_URL=https://tapriwala.acdwithsameer.com
#   PUBLIC_BASE_URL=https://tapriwala-api.acdwithsameer.com
#
#   STORAGE_DRIVER=bunny
#   BUNNY_STORAGE_ZONE=<zone>
#   BUNNY_ACCESS_KEY=<zone password>
#   BUNNY_CDN_URL=https://<zone>.b-cdn.net

# ─── Business rules ──────────────────────────────────────────────────────────
# Minutes after which an unattended service request / ready order is escalated
SERVICE_REQUEST_ESCALATION_MINUTES=5
READY_ORDER_ESCALATION_MINUTES=5
# Sequence reset policy for session numbers: daily | never
SESSION_NUMBER_RESET=daily
DEFAULT_TAX_PERCENT=5

# ─── Storage (menu item images) ──────────────────────────────────────────────
# local = disk (dev)   |   bunny = Bunny.net Storage + CDN (production)
STORAGE_DRIVER=local

# --- local driver ---
UPLOAD_DIR=uploads
UPLOAD_URL_PATH=/uploads
# Origin this API is reachable on — local image URLs are built from it.
PUBLIC_BASE_URL=http://localhost:5010

# --- bunny driver (required when STORAGE_DRIVER=bunny) ---
# Write host. Region-specific: sg / ny / la / uk … . Needs BUNNY_ACCESS_KEY.
BUNNY_BASE_URL=https://sg.storage.bunnycdn.com
BUNNY_REGION=sg
BUNNY_STORAGE_ZONE=your-storage-zone
# Storage zone password from the Bunny dashboard (FTP & API Access). SECRET.
BUNNY_ACCESS_KEY=
# Public pull-zone host — this is what customer phones load images from.
BUNNY_CDN_URL=https://your-zone.b-cdn.net
# Prefix inside the zone, so a shared zone stays tidy per project.
BUNNY_FOLDER=acd-cafe

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600

# ─── Seed script defaults ────────────────────────────────────────────────────
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PIN=1234
